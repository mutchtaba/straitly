# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
node_modules/
.next/
.netlify/
brand/tmp/

# generated image-gen artifacts (regenerable; API key lives in .env above)
brand/imagegen/out/
brand/imagegen/refs/
brand/imagegen/*.log
